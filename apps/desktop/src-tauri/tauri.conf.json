{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalo",
  "version": "0.1.0",
  "identifier": "app.kalo.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kalo",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Lecteur musical local, open source et respectueux de vos fichiers.",
    "longDescription": "Kalo indexe et lit votre musique sur place, sans déplacer vos fichiers.",
    "copyright": "Copyright © 2026 Kalo contributors",
    "publisher": "Kalo contributors",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
